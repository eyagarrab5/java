<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ForgotPasswordController"
            prefWidth="400" prefHeight="300"
            style="-fx-background-color: #ecf0f1;">

    <VBox alignment="CENTER" spacing="20" AnchorPane.topAnchor="50" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

        <Label text="Trouvez votre compte"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

        <Label text="Veuillez entrer votre e-mail ou numéro de mobile pour rechercher votre compte."
               wrapText="true" style="-fx-text-fill: #34495e; -fx-font-size: 12px;" />

        <TextField fx:id="emailOrPhoneField" promptText="E-mail ou numéro de mobile"
                   style="-fx-background-radius: 6; -fx-border-color: #ccc; -fx-padding: 8;" />

        <HBox spacing="10" alignment="CENTER">
            <Button text="Annuler" onAction="#handleCancel"
                    style="-fx-background-color: #bdc3c7; -fx-text-fill: white;" />
            <Button text="Rechercher" onAction="#handleSearch"
                    style="-fx-background-color: #3498db; -fx-text-fill: white;" />
        </HBox>

        <Label fx:id="feedbackLabel" textFill="red" visible="false"/>

    </VBox>
</AnchorPane>
