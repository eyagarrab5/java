<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.RenitialiserMotDePasseController" prefWidth="600" prefHeight="400">
    <VBox alignment="CENTER" spacing="20" layoutX="50" layoutY="30" prefWidth="500">

        <ToggleGroup fx:id="choiceGroup" />
        <Label text="Réinitialiser votre mot de passe" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        
        <Label text="Comment voulez-vous recevoir votre code de réinitialisation du mot de passe ?" wrapText="true" />



        <RadioButton fx:id="emailOption"
                     text="Envoyer le code par email"
                     toggleGroup="#choiceGroup" />

        <RadioButton fx:id="smsOption"
                     text="Envoyer le code par texto"
                     toggleGroup="#choiceGroup" />



        <Label fx:id="usernameLabel" text="Nom d’utilisateur ici" style="-fx-font-style: italic;" />

        <HBox spacing="15">
            <Button text="back" onAction="#handleCancel" style="-fx-background-color: #1877f2; -fx-text-fill: white;" />
            <Button text="Continuer" onAction="#handleContinue" style="-fx-background-color: #1877f2; -fx-text-fill: white;" />
        </HBox>
    </VBox>
</AnchorPane>
