<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<?import javafx.scene.layout.HBox?>
<AnchorPane prefHeight="600.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AjouterUtilisateurController">

    <children>
        <Label layoutX="50.0" layoutY="30.0" text="Prénom"
               style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
        <TextField fx:id="nomField" layoutX="200.0" layoutY="25.0"
                   style="-fx-background-radius: 6; -fx-border-color: #ccc; -fx-padding: 8;"/>

        <Label layoutX="50.0" layoutY="80.0" text="Nom"
               style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
        <TextField fx:id="prenomField" layoutX="200.0" layoutY="75.0"
                   style="-fx-background-radius: 6; -fx-border-color: #ccc; -fx-padding: 8;"/>

        <Label layoutX="50.0" layoutY="130.0" text="Email"
               style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
        <TextField fx:id="emailField" layoutX="200.0" layoutY="125.0"
                   style="-fx-background-radius: 6; -fx-border-color: #ccc; -fx-padding: 8;"/>

        <Label layoutX="50.0" layoutY="180.0" text="Téléphone"
               style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
        <TextField fx:id="telephoneField" layoutX="200.0" layoutY="175.0"
                   style="-fx-background-radius: 6; -fx-border-color: #ccc; -fx-padding: 8;"/>

        <!-- Mot de passe -->
        <Label layoutX="50.0" layoutY="230.0" text="Mot de passe"
               style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
        <HBox layoutX="200.0" layoutY="225.0" spacing="5">
            <PasswordField fx:id="passwordField" promptText="Mot de passe"
                           style="-fx-background-radius: 6; -fx-border-color: #ccc; -fx-padding: 8;" />
            <TextField fx:id="passwordVisibleField" promptText="Mot de passe"
                       style="-fx-background-radius: 6; -fx-border-color: #ccc; -fx-padding: 8;"
                       visible="false" managed="false" />
            <Button text="👁" onAction="#togglePasswordVisibility"
                    style="-fx-background-color: transparent;" />
        </HBox>
        <Label fx:id="passwordError" layoutX="200.0" layoutY="255.0" textFill="red" />

        <!-- Confirmation du mot de passe -->
        <Label layoutX="50.0" layoutY="280.0" text="Confirmer le mot de passe"
               style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
        <HBox layoutX="200.0" layoutY="275.0" spacing="5">
            <PasswordField fx:id="confirmPasswordField" promptText="Confirmer le mot de passe"
                           style="-fx-background-radius: 6; -fx-border-color: #ccc; -fx-padding: 8;" />
            <TextField fx:id="confirmPasswordVisibleField" promptText="Confirmer le mot de passe"
                       style="-fx-background-radius: 6; -fx-border-color: #ccc; -fx-padding: 8;"
                       visible="false" managed="false" />
            <Button text="👁" onAction="#toggleConfirmPasswordVisibility"
                    style="-fx-background-color: transparent;" />
        </HBox>
        <Label fx:id="confirmPasswordError" layoutX="200.0" layoutY="305.0" textFill="red" />


        <Label layoutX="50.0" layoutY="330.0" text="Rôle"
               style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
        <TextField fx:id="roleField" layoutX="200.0" layoutY="325.0"
                   style="-fx-background-radius: 6; -fx-border-color: #ccc; -fx-padding: 8;"/>

        <Label layoutX="50.0" layoutY="380.0" text="Véhicule"
               style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
        <TextField fx:id="vehiculeField" layoutX="200.0" layoutY="375.0"
                   style="-fx-background-radius: 6; -fx-border-color: #ccc; -fx-padding: 8;"/>

        <Label layoutX="50.0" layoutY="430.0" text="Vérifié"
               style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
        <CheckBox fx:id="verifiedCheckBox" layoutX="200.0" layoutY="425.0"/>

        <!-- Bouton "Ajouter" -->
        <Button layoutX="250.0" layoutY="500.0" mnemonicParsing="false"
                fx:id="enregistrerButton" text="Ajouter"
                onAction="#enregistrerUtilisateur"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 20;"/>

        <!-- Bouton pour voir la liste des utilisateurs -->
        <Button layoutX="220.0" layoutY="550.0" mnemonicParsing="false"
                text="Voir la liste des utilisateurs"
                onAction="#goToListeUtilisateurs"
                style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-underline: true;"/>

    </children>
</AnchorPane>