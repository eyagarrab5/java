<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.paint.Color?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.MesOffresController" prefWidth="1200" prefHeight="800"
            style="-fx-background-color: #f8fafc;">

    <!-- Top Navbar - More elegant and spacious -->
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 18; -fx-background-radius: 15; -fx-background-color: linear-gradient(to right, #ffffffcc, #f0f9ff); -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 12, 0, 0, 4);">
            <Label text="🚗 COVOITMOB"
                   style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #0b2e4a; -fx-font-family: 'Segoe UI';"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <HBox spacing="15" alignment="CENTER">
                <MenuButton text="🚙 Offres"
                            style="-fx-background-color: #ffffff88; -fx-text-fill: #003366; -fx-font-size: 17px; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 10 18;">
                    <items>
                        <MenuItem fx:id="mesOffresItem" text="📄 Mes offres" onAction="#handleMesOffres"/>
                        <MenuItem fx:id="autresOffresItem" text="🌐 Les offres des autres" onAction="#handleAutresOffres"/>
                    </items>
                </MenuButton>

                <Button fx:id="ajouterButton" text="➕ Ajouter" onAction="#handleAjouterAction"
                        style="-fx-background-color: #005288; -fx-text-fill: white; -fx-font-size: 17px; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 10 22;">
                    <effect>
                        <DropShadow color="#8ecae6" radius="9"/>
                    </effect>
                </Button>

                <Button text="📋 Listes" onAction="#handleListeAction"
                        style="-fx-background-color: #ffffffaa; -fx-text-fill: #003244; -fx-font-size: 17px; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 10 22;">
                    <effect>
                        <DropShadow color="#bfd7ff" radius="6"/>
                    </effect>
                </Button>
            </HBox>
        </HBox>
    </top>

    <!-- Center Content - More spacious and elegant -->
    <center>
        <VBox spacing="30" alignment="TOP_CENTER" style="-fx-padding: 40;">
            <!-- Subtle header with more space -->
            <VBox spacing="10" alignment="CENTER">
                <Label text="Vos offres publiées"
                       style="-fx-font-size: 24px; -fx-font-weight: 700; -fx-text-fill: #1e3a8a; -fx-font-family: 'Segoe UI';"/>
                <Label text="Vous pouvez les modifier ou les supprimer à tout moment"
                       style="-fx-font-size: 20px; -fx-text-fill: #64748b; -fx-font-family: 'Segoe UI';"/>
            </VBox>

            <!-- Pagination and Cards container -->
            <Pagination fx:id="pagination"
                        style="
                -fx-background-color: transparent;
                -fx-border-color: transparent;
                -fx-background-radius: 0;
                -fx-border-radius: 0;
                -fx-padding: 0;
                -fx-effect: none;
                -fx-font-size: 16px;
                -fx-font-weight: 600;
                -fx-font-family: 'Segoe UI', 'Helvetica Neue', sans-serif;
                -fx-text-fill: #1e3a8a;
                -fx-cursor: hand;
            " />                <FlowPane fx:id="mesOffresContainer" hgap="30" vgap="30" alignment="TOP_CENTER" prefWrapLength="1000"
                          style="-fx-padding: 1;"/>
        </VBox>
    </center>

    <!-- Subtle footer -->
    <bottom>
        <VBox alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #f1f5f9;">
            <Label text="© 2025 COVOITMOB" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
        </VBox>
    </bottom>

</BorderPane>